PAYLOAD_SECRET=mygeneratedsecret

# Postgres (Neon). L'adaptateur est @payloadcms/db-postgres.
# PREPROD_DATABASE_URL est prioritaire s'il est défini — c'est la branche de travail.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
PREPROD_DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

COMPANY_NAME="Paralelo 8 Norte"
TWITTER_CREATOR=
TWITTER_SITE=
SITE_NAME="Paralelo 8 Norte"

PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Used to preview drafts
PREVIEW_SECRET=demo-draft-secret

# Stripe API keys
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOKS_SIGNING_SECRET=whsec_

# Printify — jeton personnel (Printify > My profile > Connections) et boutique cible.
# `PRINTIFY_SHOP_ID` est obligatoire : le compte porte plusieurs boutiques, et deviner
# laquelle enverrait des commandes réelles au mauvais endroit. `GET /v1/shops.json` les liste.
PRINTIFY_TOKEN=
PRINTIFY_SHOP_ID=

# Cloudflare R2 — stockage des médias (API compatible S3).
# Sans ces quatre variables, les uploads retombent sur `public/media`, que Vercel
# remet à zéro à chaque déploiement et interdit en écriture au runtime.
# `CLOUDFLARE_R2` se colle telle que Cloudflare l'affiche, bucket compris.
# `CLOUDFLARE_R2_PUBLIC_URL` est le domaine de lecture (r2.dev ou domaine perso) :
# l'endpoint S3 sert à écrire, il n'affiche rien dans un navigateur.
CLOUDFLARE_R2=https://<account-id>.r2.cloudflarestorage.com/<bucket>
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PUBLIC_URL=https://pub-<hash>.r2.dev
