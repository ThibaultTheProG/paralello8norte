PAYLOAD_SECRET=mygeneratedsecret

# Postgres (Neon). L'adaptateur est @payloadcms/db-postgres.
# PREPROD_DATABASE_URL est prioritaire s'il est défini — c'est la branche de travail.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
PREPROD_DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

COMPANY_NAME="Paralelo 8 Norte"
TWITTER_CREATOR=
TWITTER_SITE=
SITE_NAME="Paralelo 8 Norte"

PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Used to preview drafts
PREVIEW_SECRET=demo-draft-secret

# Stripe API keys
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOKS_SIGNING_SECRET=whsec_

# Printify — jeton personnel (Printify > My profile > Connections) et boutique cible.
# `PRINTIFY_SHOP_ID` est obligatoire : le compte porte plusieurs boutiques, et deviner
# laquelle enverrait des commandes réelles au mauvais endroit. `GET /v1/shops.json` les liste.
PRINTIFY_TOKEN=
PRINTIFY_SHOP_ID=
